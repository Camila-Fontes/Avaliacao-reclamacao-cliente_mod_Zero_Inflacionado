# Componente de contagem: fatores associados a quantidade de reclamacoes.
formula_contagem = """
1 + qtd_compras_z
  + qtd_interacoes_z
  + qtd_atrasos_z
  + qtd_falhas_z
  + severidade_maxima
  + problema_detectado_internamente
  + tempo_resolucao_z
  + C(segmento)
"""

# Componente de inflacao de zeros: fatores associados a pertencer ao
# processo latente que gera zeros adicionais.
formula_inflacao = """
1 + conhece_canal_reclamacao
  + acessou_pagina_ajuda
  + abandonou_formulario
  + erro_no_canal
  + tempo_espera_z
  + dificuldade_canal
  + tempo_disponivel_percebido
  + confianca_na_resolucao
"""

X_contagem = construir_matriz(dados_modelo, formula_contagem)
X_inflacao = construir_matriz(dados_modelo, formula_inflacao)
y = dados_modelo["qtd_reclamacoes"].astype(float)
offset = dados_modelo["log_exposicao"].astype(float)

vif = calcular_vif(X_contagem)

# ============================================================
# 8. AJUSTE DOS MODELOS
# ============================================================

print("\nAjustando modelo Poisson...")
modelo_poisson = Poisson(
    endog=y,
    exog=X_contagem,
    offset=offset,
)
resultado_poisson = modelo_poisson.fit(
