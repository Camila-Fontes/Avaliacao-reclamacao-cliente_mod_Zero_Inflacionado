})

dados_modelo["evidencia_problema"] = indicadores_problema.max(axis=1)

dados_modelo["score_reclamacao_silenciosa"] = np.where(
    dados_modelo["qtd_reclamacoes"].eq(0),
    dados_modelo["prob_zero_processo_reclamacao"]
    * (0.5 + 0.5 * dados_modelo["evidencia_problema"]),
    0.0,
)

condicoes = [
    dados_modelo["qtd_reclamacoes"].gt(0),
    (
        dados_modelo["qtd_reclamacoes"].eq(0)
        & dados_modelo["prob_zero_estrutural_posterior"].ge(LIMITE_ZERO_ESTRUTURAL)
        & dados_modelo["evidencia_problema"].eq(0)
    ),
    (
        dados_modelo["qtd_reclamacoes"].eq(0)
        & dados_modelo["score_reclamacao_silenciosa"].ge(LIMITE_RISCO_ALTO)
    ),
    (
        dados_modelo["qtd_reclamacoes"].eq(0)
        & dados_modelo["score_reclamacao_silenciosa"].ge(LIMITE_RISCO_MODERADO)
