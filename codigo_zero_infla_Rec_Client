# Observado versus esperado por quantidade de reclamacoes.
frequencia_observada = (
    dados_modelo["qtd_reclamacoes"]
    .value_counts()
    .sort_index()
    .rename("observado")
)

# Simulacao preditiva simples a partir das probabilidades ZINB ajustadas.
rng = np.random.default_rng(20260828)
pi = dados_modelo["prob_zero_estrutural_prior"].to_numpy()
zero_estrutural_sim = rng.binomial(1, pi)
contagem_sim = nbinom.rvs(size, prob_nb, random_state=rng)
y_simulado = np.where(zero_estrutural_sim == 1, 0, contagem_sim)

frequencia_simulada = (
    pd.Series(y_simulado)
    .value_counts()
    .sort_index()
    .rename("simulado")
)

comparacao_frequencias = pd.concat(
    [frequencia_observada, frequencia_simulada],
    axis=1,
).fillna(0).reset_index(names="qtd_reclamacoes")

limite_grafico = int(min(10, comparacao_frequencias["qtd_reclamacoes"].max()))
grafico_freq = comparacao_frequencias.loc[
    comparacao_frequencias["qtd_reclamacoes"].le(limite_grafico)
].melt(
    id_vars="qtd_reclamacoes",
