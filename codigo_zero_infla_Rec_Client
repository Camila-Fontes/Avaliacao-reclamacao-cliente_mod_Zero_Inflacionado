def verificar_colunas(dados: pd.DataFrame, colunas: list[str]) -> None:
    """Interrompe a execucao quando faltam colunas obrigatorias."""
    faltantes = [coluna for coluna in colunas if coluna not in dados.columns]
    if faltantes:
        raise ValueError(f"Colunas obrigatorias ausentes: {faltantes}")


def padronizar_serie(serie: pd.Series) -> pd.Series:
    """Padroniza uma variavel numerica, preservando o indice."""
    serie = pd.to_numeric(serie, errors="coerce")
    desvio = serie.std(ddof=0)
    if pd.isna(desvio) or desvio == 0:
        return pd.Series(np.zeros(len(serie)), index=serie.index)
    return (serie - serie.mean()) / desvio


def construir_matriz(dados: pd.DataFrame, formula: str) -> pd.DataFrame:
    """Cria uma matriz de projeto com intercepto e variaveis categoricas."""
    return dmatrix(formula, dados, return_type="dataframe")


def obter_metricas_modelo(nome: str, resultado) -> dict:
    """Extrai metricas comparaveis dos modelos ajustados."""
    return {
        "modelo": nome,
        "AIC": float(resultado.aic),
        "BIC": float(resultado.bic),
        "logLik": float(resultado.llf),
        "numero_parametros": int(len(resultado.params)),
        "convergiu": bool(getattr(resultado, "mle_retvals", {}).get("converged", True)),
    }


def tabela_coeficientes(resultado, nome_modelo: str) -> pd.DataFrame:
    """Cria tabela com coeficientes, erros, p-valores e razoes exponenciadas."""
    intervalo = resultado.conf_int()
    tabela = pd.DataFrame({
        "termo": resultado.params.index,
        "coeficiente": resultado.params.values,
        "erro_padrao": resultado.bse.values,
        "estatistica_z": resultado.tvalues.values,
        "p_valor": resultado.pvalues.values,
        "limite_inferior_95": intervalo.iloc[:, 0].values,
        "limite_superior_95": intervalo.iloc[:, 1].values,
    })
    tabela["razao_exponenciada"] = np.exp(tabela["coeficiente"].clip(-20, 20))
    tabela["modelo"] = nome_modelo
    tabela["componente"] = np.where(
        tabela["termo"].str.startswith("inflate_"),
        "inflacao_zero",
        np.where(tabela["termo"].eq("alpha"), "dispersao", "contagem"),
    )
    return tabela


def calcular_vif(matriz: pd.DataFrame) -> pd.DataFrame:
    """Calcula VIF para as colunas preditoras, exceto intercepto."""
    from statsmodels.stats.outliers_influence import variance_inflation_factor

    x = matriz.copy()
    if "Intercept" in x.columns:
        x = x.drop(columns="Intercept")

    registros = []
    for i, coluna in enumerate(x.columns):
        try:
            vif = variance_inflation_factor(x.values, i)
        except Exception:
            vif = np.nan
        registros.append({"variavel": coluna, "VIF": vif})
    return pd.DataFrame(registros).sort_values("VIF", ascending=False)


def quantil_residuo_aleatorizado(y: np.ndarray, mu: np.ndarray, alpha: float) -> np.ndarray:
    """
    Gera uma aproximacao de residuos quantilicos aleatorizados para ZINB.
    Utilizada apenas como diagnostico complementar.
    """
    rng = np.random.default_rng(20260828)
    size = 1.0 / max(alpha, 1e-8)
    prob = size / (size + np.maximum(mu, 1e-12))

    limite_inferior = nbinom.cdf(np.maximum(y - 1, -1), size, prob)
    limite_superior = nbinom.cdf(y, size, prob)
    uniforme = rng.uniform(limite_inferior, limite_superior)

    from scipy.stats import norm
    uniforme = np.clip(uniforme, 1e-8, 1 - 1e-8)
    return norm.ppf(uniforme)

