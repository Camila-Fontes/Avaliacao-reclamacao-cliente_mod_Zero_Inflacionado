)
resultado_nb = modelo_nb.fit(
    method="bfgs",
    maxiter=500,
    disp=False,
)

print("Ajustando modelo ZIP...")
modelo_zip = ZeroInflatedPoisson(
    endog=y,
    exog=X_contagem,
    exog_infl=X_inflacao,
    offset=offset,
    inflation="logit",
)
resultado_zip = modelo_zip.fit(
    method="bfgs",
    maxiter=800,
    disp=False,
)

print("Ajustando modelo ZINB...")
modelo_zinb = ZeroInflatedNegativeBinomialP(
    endog=y,
    exog=X_contagem,
    exog_infl=X_inflacao,
    offset=offset,
    inflation="logit",
    p=2,
)
resultado_zinb = modelo_zinb.fit(
