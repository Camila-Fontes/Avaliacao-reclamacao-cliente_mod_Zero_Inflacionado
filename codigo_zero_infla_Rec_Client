coeficientes_zinb = tabela_coeficientes(resultado_zinb, "ZINB")

# ============================================================
# 10. PREVISOES DO MODELO ZINB
# ============================================================

# Media total esperada, incorporando o processo de inflacao de zeros.
dados_modelo["reclamacoes_esperadas"] = resultado_zinb.predict(which="mean")

# Media do processo principal de contagem, antes da inflacao de zeros.
dados_modelo["media_condicional"] = resultado_zinb.predict(which="mean-main")

# Probabilidade de permanecer no processo principal de contagem.
prob_processo_principal = resultado_zinb.predict(which="prob-main")

# Probabilidade a priori de pertencer ao componente de zeros adicionais.
dados_modelo["prob_zero_estrutural_prior"] = 1.0 - prob_processo_principal

# Parametro alpha da parametrizacao NB2:
# Var(Y) = mu + alpha * mu^2
alpha = float(resultado_zinb.params.get("alpha", np.nan))
if not np.isfinite(alpha) or alpha <= 0:
    raise ValueError("O parametro alpha do ZINB nao foi estimado corretamente.")

size = 1.0 / alpha
mu = np.maximum(dados_modelo["media_condicional"].to_numpy(), 1e-12)
prob_nb = size / (size + mu)

# Probabilidade de zero produzido pelo componente de contagem NB.
dados_modelo["prob_zero_processo_contagem"] = nbinom.pmf(
    0,
    size,
    prob_nb,
)

pi = dados_modelo["prob_zero_estrutural_prior"].to_numpy()
p_zero_contagem = dados_modelo["prob_zero_processo_contagem"].to_numpy()

denominador = pi + (1.0 - pi) * p_zero_contagem
posterior_estrutural = np.divide(
    pi,
    denominador,
    out=np.zeros_like(pi),
    where=denominador > 0,
)

eh_zero = dados_modelo["qtd_reclamacoes"].eq(0).to_numpy()

dados_modelo["prob_zero_estrutural_posterior"] = np.where(
    eh_zero,
    posterior_estrutural,
    np.nan,
)

dados_modelo["prob_zero_processo_reclamacao"] = np.where(
    eh_zero,
    1.0 - posterior_estrutural,
    np.nan,
)

